# Copiá este archivo como .env y completá tu API key de Gemini
# Conseguila gratis en: https://aistudio.google.com/apikey

GEMINI_API_KEY=tu_api_key_aqui

# Puerto del servidor (opcional, por defecto 3001)
PORT=3001

# Origen permitido para CORS — en desarrollo tu Astro corre en 4321
# En producción cambiá esto por la URL real de tu portfolio
ALLOWED_ORIGIN=http://localhost:4321
